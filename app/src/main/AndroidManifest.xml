<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- ① 位置情報を使うことをシステムに宣言する権限 -->
    <!-- ACCESS_FINE_LOCATION: GPSなどを使った高精度な位置情報 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- ACCESS_COARSE_LOCATION: Wi-Fiや基地局を使ったおおまかな位置情報(念のため一緒に宣言) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ★追加:端末を振動させるための権限 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ★追加:歩数センサーを使うための権限(Android 10以降で必須) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- ★追加:心拍センサーを使うための権限 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- ★application タグは1個だけにする -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />

        <!-- ★Google Play servicesのバージョン情報(これが今回のエラーの解決に必須) -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ★追加:スマホからのメッセージを受け取るサービス -->
        <service
            android:name=".presentation.DestinationListenerService"
            android:exported="true">
            <!-- ★追加:DataItemの変更を検知するための宣言 -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/destination" />
            </intent-filter>
        </service>
    </application>

</manifest>